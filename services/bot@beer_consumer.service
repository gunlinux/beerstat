[Unit]
Description=BeerStat donation consumer
After=network-online.target
Wants=network-online.target

[Service]
User=loki
WorkingDirectory=/home/loki/projects/bot/beerstat/
EnvironmentFile=-/home/loki/projects/bot/beerstat/.env
Environment="RUST_LOG=info"
ExecStart=/home/loki/projects/bot/beerstat/target/release/beerstat
Restart=always
RestartSec=5
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/home/loki/.cargo/bin"
Environment="SSL_CERT_FILE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem"
Environment="SSL_CERT_DIR=/dev/null"

[Install]
WantedBy=multi-user.target
