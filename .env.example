# Copy to .env and adjust for the deployment.
# The virtual host goes in the URI path (here: /gunlinux_bot).
#
# Production (gunlinux.ru) reuses the donation_alerts broker and consumes its
# raw donation queue:
#   RABBIT_URL=amqp://donate_consumer:password@127.0.0.1:5674/prod
#   BEER_STAT=donations
#   BEER_DLQ=-
RABBIT_URL=amqp://user:password@localhost:5672/gunlinux_bot
BEER_URL=http://127.0.0.1:6016/donate
BEER_STAT=bs_donats
# Routing key for failed messages; defaults to <BEER_STAT>.dlq.
# Set BEER_DLQ=- (or off/none/empty) to declare the queue without
# x-dead-letter-* arguments, required when another producer declared it first.
# BEER_DLQ=bs_donats.dlq
RUST_LOG=info
